<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.TimelapseRTSP.SequenceItems"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.WPF.Base">

    <DataTemplate DataType="{x:Type local:StartTimelapseCapture}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <TextBlock Text="Capture every " VerticalAlignment="Center"/>
                    <TextBox Text="{Binding CaptureIntervalOverride, UpdateSourceTrigger=PropertyChanged}"
                             Width="50" Margin="5,0"
                             ToolTip="Override capture interval (0 = use plugin settings)"/>
                    <TextBlock Text="s (0 = default)" VerticalAlignment="Center"/>
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:StopTimelapseCapture}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <TextBlock Text="Stop capture, encode &amp; deliver" VerticalAlignment="Center"/>
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>
</ResourceDictionary>
